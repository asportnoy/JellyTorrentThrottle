# ── Webhook listener ──────────────────────────────────────────
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=18080

# ── qBittorrent connection ────────────────────────────────────
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

# ── Speed mode ────────────────────────────────────────────────
# "alternative" – toggles qBittorrent's built-in "alternative speed limits" switch (the
#                 same one in the WebUI) on while Jellyfin is playing, and back off when it stops
# "custom"      – uses the values below as throttle limits
SPEED_MODE=alternative

# Only used when SPEED_MODE=custom (values in KiB/s)
THROTTLE_DOWNLOAD_LIMIT=1024
THROTTLE_UPLOAD_LIMIT=512

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/jellyfin_qbittorrent.log
